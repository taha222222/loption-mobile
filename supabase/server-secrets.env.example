# =====================================================================
# SERVER-SIDE SECRETS — TEMPLATE ONLY. NOT READ BY THE MOBILE APP.
#
# Every value below is private. Enter the real values directly in the
# Supabase Dashboard (hosted projects) or in a secrets manager / an
# uncommitted file used by the Supabase CLI for a local stack.
#   * Never commit real values (*.env, .env.* and *.p8 are git-ignored).
#   * Never copy them into .env as EXPO_PUBLIC_* variables: those are
#     bundled into the app and readable by anyone.
# Where each value goes and how to verify it: docs/v1/AUTH_PROVIDER_SETUP.md
# All values are intentionally empty until the owner supplies them.
# =====================================================================

# --- Google (Google Cloud Console > APIs & Services > Credentials) ----
# OAuth client of type "Web application"; authorized redirect URI:
#   https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Apple (Apple Developer > Certificates, Identifiers & Profiles) ----
# Client IDs Supabase accepts: the iOS bundle id (native sign-in) and the
# Services ID (web/Android OAuth), comma-separated, e.g.
#   com.loption.app,<services-id>
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
# Client secret for the web flow: a JWT signed with the Sign in with Apple
# key (.p8). It expires (at most every 6 months) and must be regenerated.
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path to the .p8 key file, kept outside the repository.
APPLE_SIGN_IN_PRIVATE_KEY_PATH=

# --- Verification e-mails through Resend (Supabase Auth SMTP) ---------
# Supabase Dashboard > Authentication > SMTP Settings:
#   host smtp.resend.com, port 465, username "resend", password = API key
RESEND_API_KEY=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=
