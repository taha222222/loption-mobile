{
  "expo": {
    "name": "LOPTION",
    "slug": "loption",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "loption",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loption.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "L'OPTION utilise votre position pour proposer votre adresse de livraison, mesurer la distance d'une séance que vous démarrez (uniquement pendant cette séance, y compris écran verrouillé) et, pour les livreurs, suivre une livraison en cours.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "package": "com.loption.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#111827"
        }
      ],
      "expo-localization",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111827",
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "L'OPTION lit vos pas, votre distance, votre énergie active et vos séances d'entraînement pour afficher votre bilan énergétique du jour. Ces données ne sont jamais partagées.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "L'OPTION compte vos pas et votre distance avec le capteur de mouvement de l'iPhone pour votre bilan du jour. Aucune application santé n'est nécessaire."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L'OPTION utilise votre position pour proposer votre adresse de livraison, mesurer la distance d'une séance que vous démarrez (uniquement pendant cette séance, y compris écran verrouillé) et, pour les livreurs, suivre une livraison en cours.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab960bde-29d4-47e4-b7e5-8b428bf38913"
      }
    }
  }
}
