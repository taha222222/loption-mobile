# Copy to .env (git-ignored) and fill in values for YOUR OWN dev/staging project.
# Only EXPO_PUBLIC_* variables are read by the app, and every one of them is
# bundled into the client and readable by anyone with the app. Never put a
# service-role key, database password, or payment-gateway secret here.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (NOT the service_role / secret key).
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
